# --- Aplikacja ---
ASPNETCORE_ENVIRONMENT=Production

# Porty hosta (zostawiasz, je\u015bli chcesz testowa\u0107 lokalnie poza tunelem)
CLIENT_HOST_PORT=3000
SERVER_HOST_PORT=5166
POSTGRES_HOST_PORT=5432

# --- Baza danych (Postgres) ---
POSTGRES_DB=foodwise
POSTGRES_USER=foodwise
POSTGRES_PASSWORD=zmien_to_w_produkcji

# --- Cloudflare Tunnel ---
# Tryb "named tunnel" - zalecany do hostowania pod w\u0142asn\u0105 domen\u0105.
# 1. Wejd\u017a na https://one.dash.cloudflare.com -> Networks -> Tunnels -> Create a tunnel
# 2. Wybierz "Cloudflared" jako konektor, nadaj nazw\u0119 (np. "foodwise")
# 3. Skopiuj token z polecenia "docker run ... --token ey..." i wklej poni\u017cej
# 4. W zak\u0142adce "Public Hostnames" zmapuj domeny do us\u0142ug:
#       app.twoja-domena.pl   -> http://client:8080
#       api.twoja-domena.pl   -> http://server:8080   (opcjonalnie)
#    (us\u0142ugi s\u0105 widoczne w sieci docker `foodwise-net`)
CLOUDFLARED_TOKEN=
